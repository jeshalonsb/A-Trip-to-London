  speakerText: {fileID: 906507895}
  dialogueText: {fileID: 2048684487}
  continueButton: {fileID: 1722415749}
  dialogueLines:
  - speakerName: 
    dialogueText: Finally in London! What a long trip that was
  - speakerName: 
    dialogueText: The environtment seems very busy and moved and the skies are very
      grey and uhh...
  - speakerName: 
    dialogueText: THEY DRIVE ON THE LEFT SIDE??
  - speakerName: 
    dialogueText: The taxi took my bags to the hotel and I dont check in till later
  - speakerName: 
    dialogueText: I'll explore the city for the time being
  playerController: {fileID: 1734032232}
  playerInputs: {fileID: 1734032235}
  useTypingEffect: 0
  typingSpeed: 0.025
